@using aznews.Areas.Admin.Models
@using aznews.Areas.Admin.Models.DuyetDiem
@model IEnumerable<DuyetRowVM>

@{
    ViewData["Title"] = "PHÊ DUYỆT ĐIỂM";
    var q = (ViewBag.Q as string) ?? "";
    int stt = 0;

    Func<DiemStatus, (string cls, string txt)> badge = s =>
    {
        switch (s)
        {
            case DiemStatus.Submitted: return ("bg-warning text-dark", "Đã gửi duyệt");
            case DiemStatus.Approved: return ("bg-success", "Đã duyệt");
            case DiemStatus.Rejected: return ("bg-danger", "Từ chối");
            default: return ("bg-secondary", "Có thể sửa");
        }
    };
}

<section class="section">
    <div class="pagetitle mb-3">
        <h4 class="fw-bold text-primary">PHÊ DUYỆT ĐIỂM</h4>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center my-3">
                <form asp-area="Admin" asp-controller="DuyetDiem" asp-action="Index" method="get"
                      class="d-flex gap-2" role="search">
                    <input name="q" value="@q" class="form-control" style="min-width:320px"
                           placeholder="Tìm theo tên/Mã HP, GV..." />
                    <button class="btn btn-outline-secondary"><i class="bi bi-search"></i></button>
                </form>
            </div>

            <div class="table-responsive">
                <table class="table table-hover table-bordered align-middle shadow-sm">
                    <thead class="table-light">
                        <tr>
                            <th style="width:70px;">STT</th>
                            <th>Tên học phần</th>
                            <th style="width:110px;">Học kỳ</th>
                            <th style="width:130px;">Năm học</th>
                            <th style="width:200px;">Giảng viên</th>
                            <th style="width:100px;" class="text-center">Sĩ số</th>
                            <th style="width:140px;" class="text-center">Trạng thái</th>
                            <th style="width:260px;" class="text-center">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model)
                        {
                            var b = badge(m.TrangThai);
                            <tr>
                                <td>@(++stt)</td>
                                <td>
                                    <div class="fw-semibold">
                                        @m.TenHP
                                        @if (!string.IsNullOrWhiteSpace(m.TenNhom))
                                        {
                                            <span class="text-muted">- @m.TenNhom</span>
                                        }
                                    </div>
                                    <div class="text-muted small">Mã HP: @m.MaSoHP</div>
                                </td>
                                <td>@m.HocKy</td>
                                <td>@m.NamHoc</td>
                                <td>@(m.GV ?? "-")</td>
                                <td class="text-center">@m.SoSV</td>
                                <td class="text-center">
                                    <span class="badge @b.cls">@b.txt</span>
                                </td>
                                <td class="text-center">
                                    <div class="d-inline-flex gap-2">
                                        <!-- Review -->
                                        <a class="btn btn-sm btn-outline-primary"
                                           asp-area="Admin" asp-controller="DuyetDiem" asp-action="Review"
                                           asp-route-id="@m.MaLHP" title="Xem/soát chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <!-- Duyệt luôn -->
                                        <form asp-area="Admin" asp-controller="DuyetDiem" asp-action="Approve"
                                              method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@m.MaLHP" />
                                            <button type="submit"
                                                    class="btn btn-sm btn-success"
                                                    title="Duyệt"
                                                    @(m.TrangThai == DiemStatus.Submitted ? null : new { disabled = "disabled" })>
                                                <i class="bi bi-check2-circle me-1"></i>Duyệt
                                            </button>
                                        </form>

                                        <!-- Từ chối (mở modal nhập lý do) -->
                                        <button type="button"
                                                class="btn btn-sm btn-danger"
                                                data-bs-toggle="modal" data-bs-target="#rejectModal"
                                                data-id="@m.MaLHP"
                                                @(m.TrangThai == DiemStatus.Submitted ? null : new { disabled = "disabled" })>
                                            <i class="bi bi-x-circle me-1"></i>Từ chối
                                        </button>
                                    </div>

                                    @* ghi chú thời điểm *@
                                    <div class="text-muted small mt-1">
                                        @if (m.TrangThai == DiemStatus.Submitted && m.SubmittedAt.HasValue)
                                        {
                                            <span>
                                                Gửi: @m.SubmittedAt.Value.ToString("dd/MM/yyyy HH:mm")
                                                – @m.SubmittedBy
                                            </span>
                                        }
                                        else if (m.TrangThai == DiemStatus.Approved && m.ApprovedAt.HasValue)
                                        {
                                            <span>
                                                Duyệt: @m.ApprovedAt.Value.ToString("dd/MM/yyyy HH:mm")
                                                – @m.ApprovedBy
                                            </span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* modal từ chối *@
            <div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                    <form asp-area="Admin" asp-controller="DuyetDiem" asp-action="Reject" method="post" class="modal-content">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" id="reject-id" />
                        <div class="modal-header">
                            <h5 class="modal-title">Nhập lý do từ chối</h5>
                            <button class="btn-close" data-bs-dismiss="modal" type="button"></button>
                        </div>
                        <div class="modal-body">
                            <textarea class="form-control" name="reason" rows="4"
                                      placeholder="Lý do từ chối..."></textarea>
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Hủy</button>
                            <button class="btn btn-danger" type="submit">
                                <i class="bi bi-x-circle me-1"></i>Từ chối
                            </button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</section>

<script>
    const rejectModal = document.getElementById('rejectModal');
    rejectModal?.addEventListener('show.bs.modal', function (event) {
        const btn = event.relatedTarget;
        const id = btn?.getAttribute('data-id');
        document.getElementById('reject-id').value = id || '';
    });
</script>
