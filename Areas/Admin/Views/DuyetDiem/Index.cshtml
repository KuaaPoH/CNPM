@using aznews.Areas.Admin.Models
@using aznews.Areas.Admin.Models.DuyetDiem
@model IEnumerable<DuyetRowVM>

@{
    ViewData["Title"] = "PHÊ DUYỆT ĐIỂM";
    var q = (ViewBag.Q as string) ?? "";
    int stt = 0;

    Func<DiemStatus, (string cls, string txt)> badge = s =>
    {
        switch (s)
        {
            case DiemStatus.Submitted: return ("bg-warning text-dark", "Đã gửi duyệt");
            case DiemStatus.Approved: return ("bg-success", "Đã duyệt");
            case DiemStatus.Rejected: return ("bg-danger", "Từ chối");
            default: return ("bg-secondary", "Có thể sửa");
        }
    };
}

<section class="section">
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between mb-3">
                <h4 class="fw-bold text-primary mb-0 text-uppercase">Phê duyệt điểm</h4>
            </div>

            <form asp-area="Admin" asp-controller="DuyetDiem" asp-action="Index" method="get" class="mb-3">
                <div class="input-group search-compact">
                    <input name="q" value="@q" class="form-control" placeholder="Tìm theo tên/Mã HP, GV..." />
                    <button class="btn btn-outline-secondary" type="submit"><i class="bi bi-search"></i></button>
                </div>
            </form>

            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle text-center">
                    <thead class="table-light">
                        <tr>
                            <th style="width:50px;">STT</th>
                            <th>Tên học phần</th>
                            <th style="width:100px;">Học kỳ</th>
                            <th style="width:120px;">Năm học</th>
                            <th style="width:180px;">Giảng viên</th>
                            <th style="width:80px;">Sĩ số</th>
                            <th style="width:120px;">Trạng thái</th>
                            <th style="width:180px;">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model)
                        {
                            var b = badge(m.TrangThai);
                            <tr>
                                <td>@(++stt)</td>
                                <td class="text-start">
                                    <div class="fw-semibold">
                                        @m.TenHP
                                        @if (!string.IsNullOrWhiteSpace(m.TenNhom))
                                        {
                                            <span class="text-muted">- @m.TenNhom</span>
                                        }
                                    </div>
                                    <div class="text-muted small">Mã HP: @m.MaSoHP</div>
                                </td>
                                <td>@m.HocKy</td>
                                <td>@m.NamHoc</td>
                                <td class="text-start">@(m.GV ?? "-")</td>
                                <td>@m.SoSV</td>
                                <td>
                                    <span class="badge @b.cls">@b.txt</span>
                                </td>
                                <td>
                                    <div class="d-inline-flex gap-2">
                                        <!-- Review -->
                                        <a class="btn btn-sm btn-outline-primary"
                                           asp-area="Admin" asp-controller="DuyetDiem" asp-action="Review"
                                           asp-route-id="@m.MaLHP" title="Xem chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <!-- Duyệt luôn -->
                                        <form asp-area="Admin" asp-controller="DuyetDiem" asp-action="Approve"
                                              method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@m.MaLHP" />
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-success"
                                                    title="Duyệt"
                                                    @(m.TrangThai == DiemStatus.Submitted ? null : new { disabled = "disabled" })>
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                        </form>

                                        <!-- Từ chối -->
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger"
                                                data-bs-toggle="modal" data-bs-target="#rejectModal"
                                                data-id="@m.MaLHP"
                                                title="Từ chối"
                                                @(m.TrangThai == DiemStatus.Submitted ? null : new { disabled = "disabled" })>
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </div>

                                    @* ghi chú thời điểm *@
                                    <div class="text-muted small mt-1" style="font-size: 0.75rem;">
                                        @if (m.TrangThai == DiemStatus.Submitted && m.SubmittedAt.HasValue)
                                        {
                                            <div>Gửi: @m.SubmittedAt.Value.ToString("dd/MM HH:mm")</div>
                                        }
                                        else if (m.TrangThai == DiemStatus.Approved && m.ApprovedAt.HasValue)
                                        {
                                            <div>Duyệt: @m.ApprovedAt.Value.ToString("dd/MM HH:mm")</div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
            @if (!Model.Any())
            {
                <div class="text-center text-muted py-4">
                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                    Chưa có dữ liệu
                </div>
            }

            @* Modal từ chối *@
            <div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                    <form asp-area="Admin" asp-controller="DuyetDiem" asp-action="Reject" method="post" class="modal-content">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" id="reject-id" />
                        <div class="modal-header">
                            <h5 class="modal-title">Lý do từ chối</h5>
                            <button class="btn-close" data-bs-dismiss="modal" type="button"></button>
                        </div>
                        <div class="modal-body">
                            <textarea class="form-control" name="reason" rows="4"
                                      placeholder="Nhập lý do..."></textarea>
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Hủy</button>
                            <button class="btn btn-danger" type="submit">Xác nhận từ chối</button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</section>

<script>
    const rejectModal = document.getElementById('rejectModal');
    if (rejectModal) {
        rejectModal.addEventListener('show.bs.modal', function (event) {
            const btn = event.relatedTarget;
            const id = btn.getAttribute('data-id');
            document.getElementById('reject-id').value = id || '';
        });
    }
</script>

<style>
    .search-compact {
        max-width: 360px;
    }
</style>