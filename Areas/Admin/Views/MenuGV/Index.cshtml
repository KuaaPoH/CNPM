@using aznews.Areas.Admin.Models
@model IEnumerable<AdminMenu>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    var curPage = ViewBag.Page is int p ? p : 1;
    var pageSize = ViewBag.PageSize is int s ? s : 10;
    var totalPages = ViewBag.TotalPages is int t ? t : 1;
    string q = ViewBag.Q as string ?? string.Empty;

    int stt = (curPage - 1) * pageSize + 1;

    // map tên cha (dựa trên toàn bộ Model hiện tại; nếu có phân trang phía server,
    // tên cha không có trong trang hiện tại sẽ hiển thị “—”)
    var mapParent = Model
        .GroupBy(m => m.AdminMenuID)
        .ToDictionary(g => g.Key, g => g.First().ItemName ?? "");

    // token phân trang dạng … gọn
    var tokens = new List<string>();
    void AddDots() { if (tokens.Count == 0 || tokens[^1] != "...") tokens.Add("..."); }

    if (totalPages <= 7)
    {
        for (int i = 1; i <= totalPages; i++) tokens.Add(i.ToString());
    }
    else
    {
        tokens.Add("1");
        if (curPage > 4) AddDots();
        int start = Math.Max(2, curPage - 1);
        int end = Math.Min(totalPages - 1, curPage + 1);
        for (int i = start; i <= end; i++) tokens.Add(i.ToString());
        if (curPage < totalPages - 3) AddDots();
        tokens.Add(totalPages.ToString());
    }
}

@functions {
    // Tạo văn bản route cố định prefix “giangvien/”
    string RouteText(AdminMenu m)
    {
        var ctrl = (m.ControllerName ?? "Home").Trim().Trim('/');
        var act = (m.ActionName ?? "Index").Trim().Trim('/');
        return $"giangvien/{ctrl.ToLowerInvariant()}/{act.ToLowerInvariant()}";
    }
}

<section class="section">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <!-- Tiêu đề + nút thêm -->
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="fw-bold text-primary mb-0 text-uppercase">Quản lý menu giảng viên</h4>
                        <a asp-area="Admin" asp-controller="MenuGV" asp-action="Create" class="btn btn-primary">
                            <i class="bi bi-plus-lg me-1"></i> Thêm mới
                        </a>
                    </div>

                    <!-- Thanh tìm kiếm gọn ngay dưới tiêu đề -->
                    <form asp-area="Admin" asp-controller="MenuGV" asp-action="Index" method="get" id="searchForm" class="input-group search-compact mb-4">
                        <input type="text" name="q" value="@q" class="form-control" placeholder="Tìm theo tên menu…">
                        <button class="btn btn-outline-secondary" type="submit">
                            <i class="bi bi-search"></i>
                        </button>
                        <input type="hidden" name="page" value="1" />
                    </form>

                    <!-- Bảng dữ liệu -->
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover align-middle text-center">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:6%">STT</th>
                                    <th class="text-start" style="width:24%">Tên menu</th>
                                    <th style="width:8%">Cấp</th>
                                    <th class="text-start" style="width:18%">Cấp cha</th>
                                    <th class="text-start" style="width:22%">Bộ điều khiển</th>
                                    <th style="width:10%">Hoạt động</th>
                                    <th style="width:6%">Biểu tượng</th>
                                    <th style="width:16%">Hành động</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in Model.OrderBy(x => x.ParentLevel).ThenBy(x => x.ItemName))
                                {
                                    // Tên cấp cha: nếu ParentLevel == 0 hoặc không tìm thấy, hiện "—"
                                    string parentName = (m.ParentLevel != 0 && mapParent.ContainsKey(m.ParentLevel))
                                    ? mapParent[m.ParentLevel]
                                    : "—";

                                    var routeText = RouteText(m);
                                    <tr>
                                        <td>@stt</td>
                                        <td class="text-start">@m.ItemName</td>
                                        <td>@m.ParentLevel</td>
                                        <td class="text-start">@parentName</td>
                                        <td class="text-start">
                                            <span class="route-pill">@routeText</span>
                                        </td>

                                        <td>
                                            @if (m.IsActive)
                                            {
                                                <span class="badge bg-success">Hiển thị</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Ẩn</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(m.Icon))
                                            {
                                                <i class="@m.Icon" title="@m.Icon"></i>
                                            }
                                            else
                                            {
                                                <span>—</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="d-flex justify-content-center gap-2">

                                                <!-- Nút mắt bật/tắt trạng thái, giữ nguyên q & page -->
                                                <form asp-area="Admin" asp-controller="MenuGV" asp-action="Toggle" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@m.AdminMenuID" />
                                                    <input type="hidden" name="q" value="@q" />
                                                    <input type="hidden" name="page" value="@curPage" />
                                                    <button type="submit"
                                                            class="btn btn-sm @(m.IsActive ? "btn-outline-success" : "btn-outline-secondary")"
                                                            title="Ẩn/Hiện">
                                                        <i class="bi @(m.IsActive ? "bi-eye" : "bi-eye-slash")"></i>
                                                    </button>
                                                </form>

                                                <!-- Sửa -->
                                                <a asp-area="Admin" asp-controller="MenuGV" asp-action="Edit" asp-route-id="@m.AdminMenuID"
                                                   class="btn btn-sm btn-outline-primary" title="Sửa">
                                                    <i class="bi bi-pencil-square"></i>
                                                </a>

                                                <!-- Xóa -->
                                                <form asp-area="Admin" asp-controller="MenuGV" asp-action="Delete" method="post" class="d-inline"
                                                      onsubmit="return confirm('Xóa menu: @m.ItemName ?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@m.AdminMenuID" />
                                                    <input type="hidden" name="q" value="@q" />
                                                    <input type="hidden" name="page" value="@curPage" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                    stt++;
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Phân trang -->
                    @if (totalPages > 1)
                    {
                        <nav class="d-flex justify-content-center mt-3">
                            <ul class="pagination pager-ellipses">
                                <li class="page-item @(curPage == 1 ? "disabled" : "")">
                                    <a class="page-link" asp-route-page="@(curPage - 1)" asp-route-q="@q">&lt;</a>
                                </li>

                                @foreach (var tok in tokens)
                                {
                                    if (tok == "...")
                                    {
                                        <li class="page-item disabled"><span class="page-link">…</span></li>
                                    }
                                    else
                                    {
                                        var Parse = int.Parse(tok);
                                        <li class="page-item @(Parse == curPage ? "active" : "")">
                                            <a class="page-link" asp-route-page="@Parse" asp-route-q="@q">@Parse</a>
                                        </li>
                                    }
                                }

                                <li class="page-item @(curPage == totalPages ? "disabled" : "")">
                                    <a class="page-link" asp-route-page="@(curPage + 1)" asp-route-q="@q">&gt;</a>
                                </li>
                            </ul>
                        </nav>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    /* Thanh tìm kiếm gọn */
    .search-compact {
        max-width: 320px;
    }

    @@media (max-width: 576px) {
        .search-compact {
            max-width: 100%;
        }
    }

    /* Pager giống style Khoa viện */
    .pager-ellipses .page-link {
        border-radius: 8px;
        min-width: 36px;
        text-align: center;
        color: #111 !important;
        --bs-pagination-color: #111;
        --bs-pagination-hover-color: #111;
        --bs-pagination-focus-color: #111;
    }

    .pager-ellipses .page-item + .page-item {
        margin-left: .25rem;
    }

    .pager-ellipses .page-item.active .page-link {
        color: #fff !important;
        background: #111;
        border-color: #111;
    }

    .pager-ellipses .page-item.disabled .page-link {
        color: #adb5bd !important;
        pointer-events: none;
        background: #fff;
    }

    .pager-ellipses .page-item:not(.active):not(.disabled) .page-link:hover {
        background-color: #f8f9fa;
        border-color: #e5e7eb;
    }

    .route-pill {
        display: inline-block;
        padding: 2px 8px;
        border: 1px solid #e5e7eb; /* viền xám nhạt giống bootstrap table */
        background: #f8f9fa; /* nền xám rất nhạt */
        color: #111; /* chữ đen đồng bộ */
        border-radius: 6px; /* bo tròn nhẹ */
        font-size: .95rem; /* vừa mắt, không quá nhỏ */
        line-height: 1.4;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace; /* đồng bộ kiểu 'code' */
        text-transform: none; /* không ép lowercase/uppercase */
        letter-spacing: .2px;
        white-space: nowrap;
    }

        /* Nếu có link bao quanh (cũ) thì vô hiệu màu link để đồng bộ */
        .route-pill, .route-pill:link, .route-pill:visited,
        .route-pill:hover, .route-pill:active {
            color: #111;
            text-decoration: none;
        }
</style>

@section Scripts {
    <script>
        // Gõ chậm 800ms tự submit tìm kiếm
        const f = document.getElementById("searchForm");
        if (f) {
            const inp = f.querySelector("input[name='q']");
            let timer;
            if (inp) {
                inp.addEventListener("keyup", function () {
                    clearTimeout(timer);
                    timer = setTimeout(() => {
                        f.querySelector("input[name='page']").value = "1";
                        f.submit();
                    }, 800);
                });
            }
        }
    </script>
}
