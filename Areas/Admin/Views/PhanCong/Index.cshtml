@using aznews.Areas.Admin.Models.PhanCong
@model PhanCongIndexVM

@{
    ViewData["Title"] = "PHÂN CÔNG GIẢNG DẠY";
    var namHocs = ViewBag.NamHocs as List<string>;
    var hocKys = ViewBag.HocKys as List<string>;
    var q = ViewBag.Q as string;
}

<section class="section">
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between mb-3 align-items-center">
                <h4 class="fw-bold text-primary mb-0 text-uppercase">Phân công giảng dạy</h4>
                
                <!-- Bộ lọc nhanh -->
                <form class="d-flex gap-2" method="get">
                    <select name="nam" class="form-select w-auto" onchange="this.form.submit()">
                        @foreach(var n in namHocs ?? new List<string>())
                        {
                            <option value="@n" selected="@(n == Model.SelectedNamHoc)">Năm @n</option>
                        }
                    </select>
                    <select name="hk" class="form-select w-auto" onchange="this.form.submit()">
                        @foreach(var h in hocKys ?? new List<string>())
                        {
                            <option value="@h" selected="@(h == Model.SelectedHocKy)">@h</option>
                        }
                    </select>
                    <div class="input-group" style="max-width: 300px;">
                        <input name="q" value="@q" class="form-control" placeholder="Tìm tên/mã HP..." />
                        <button class="btn btn-outline-secondary" type="submit"><i class="bi bi-search"></i></button>
                    </div>
                </form>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle">
                    <thead class="table-light text-center">
                        <tr>
                            <th style="width: 50px;">STT</th>
                            <th style="width: 120px;">Mã HP</th>
                            <th>Tên học phần</th>
                            <th style="width: 80px;">Nhóm</th>
                            <th style="width: 350px;">Giảng viên phụ trách</th>
                            <th style="width: 60px;">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int stt = 0; }
                        @foreach (var item in Model.Classes)
                        {
                            stt++;
                            <tr>
                                <td class="text-center">@stt</td>
                                <td class="text-center font-monospace">@item.MaSoHP</td>
                                <td class="fw-semibold">@item.TenHP</td>
                                <td class="text-center"><span class="badge bg-info text-dark">@item.TenNhom</span></td>
                                <td>
                                    <!-- Dropdown chọn GV -->
                                    <select class="form-select form-select-sm select-gv" 
                                            data-lhp="@item.MaLHP">
                                        <option value="0" disabled selected="@(item.MaGV == 0)">-- Chưa phân công --</option>
                                        @foreach (var gv in Model.AllGiangViens)
                                        {
                                            <option value="@gv.MaGV" selected="@(gv.MaGV == item.MaGV)">
                                                @gv.MaSoGV - @gv.TenGV
                                            </option>
                                        }
                                    </select>
                                </td>
                                <td class="text-center">
                                    <span class="status-indicator" id="status-@item.MaLHP"></span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
             @if (!Model.Classes.Any())
            {
                <div class="text-center text-muted py-4">
                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                    Không có lớp học phần nào trong học kỳ này.
                </div>
            }
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const selects = document.querySelectorAll('.select-gv');

            selects.forEach(sel => {
                sel.addEventListener('change', function () {
                    const maLHP = this.getAttribute('data-lhp');
                    const maGV = this.value;
                    const indicator = document.getElementById(`status-${maLHP}`);

                    // Visual feedback: Loading
                    indicator.innerHTML = '<div class="spinner-border spinner-border-sm text-secondary" role="status"></div>';
                    this.disabled = true;

                    fetch('/Admin/PhanCong/Update', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ maLHP: parseInt(maLHP), maGV: parseInt(maGV) })
                    })
                    .then(response => {
                        if (response.ok) return response.json();
                        throw new Error('Network response was not ok');
                    })
                    .then(data => {
                        indicator.innerHTML = '<i class="bi bi-check-circle-fill text-success fs-5"></i>';
                        setTimeout(() => { indicator.innerHTML = ''; }, 2000);
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        indicator.innerHTML = '<i class="bi bi-x-circle-fill text-danger fs-5" title="Lỗi cập nhật"></i>';
                        alert("Không thể cập nhật giảng viên. Vui lòng thử lại.");
                    })
                    .finally(() => {
                        this.disabled = false;
                    });
                });
            });
        });
    </script>
}