@using aznews.Areas.GiangVien.Models.Diem
@using aznews.Areas.Admin.Models
@model DiemManageVM
@{
    ViewData["Title"] = "Nhập điểm sinh viên";
    var editable = Model.TrangThai == DiemTrangThai.Editable;
}

@section styles {
    <style>
        .score-input {
            max-width: 80px;
            text-align: center;
            font-weight: bold;
        }

        .score-total {
            font-weight: bold;
            color: #0d6efd;
        }

        .row-dirty {
            background: #fff9e6 !important;
        }

        .table thead th {
            white-space: nowrap;
            background-color: #f8f9fa;
        }
    </style>
}

<section class="section">
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h4 class="fw-bold text-primary mb-0 text-uppercase">Nhập / Sửa điểm sinh viên</h4>
                    <div class="text-muted small mt-1">
                        <span class="fw-bold text-dark">@Model.TenHP</span> • 
                        Học kỳ: <span class="badge bg-light text-dark border">@Model.HocKy</span> • 
                        Năm học: <span class="badge bg-light text-dark border">@Model.NamHoc</span>
                    </div>
                </div>
                <div>
                    @{
                        string stCls = "secondary";
                        string stText = "N/A";
                        switch (Model.TrangThai)
                        {
                            case DiemTrangThai.Editable: stCls = "secondary"; stText = "Có thể sửa"; break;
                            case DiemTrangThai.Submitted: stCls = "warning text-dark"; stText = "Chờ duyệt"; break;
                            case DiemTrangThai.Approved: stCls = "success"; stText = "Đã duyệt"; break;
                            case DiemTrangThai.Rejected: stCls = "danger"; stText = "Từ chối"; break;
                        }
                    }
                    <span class="badge bg-@stCls px-3 py-2 fs-6">@stText</span>
                </div>
            </div>

            <div class="alert alert-info py-2 small mb-3">
                <i class="bi bi-info-circle me-1"></i> 
                <strong>Quy ước:</strong> Điểm QT (Quá trình), Điểm Thi, Điểm Tổng = (QT + Thi) / 2.
            </div>

            <form asp-area="GiangVien" asp-controller="Diem" asp-action="Save" method="post" id="frmScores">
                @Html.AntiForgeryToken()
                <input type="hidden" name="MaLHP" value="@Model.MaLHP" />

                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle text-center">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 50px;">STT</th>
                                <th style="width: 120px;">Mã SV</th>
                                <th class="text-start">Họ tên sinh viên</th>
                                <th style="width: 130px;">Điểm QT</th>
                                <th style="width: 130px;">Điểm Thi</th>
                                <th style="width: 130px;">Điểm Tổng</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Rows.Count; i++)
                            {
                                var r = Model.Rows[i];
                                <tr data-row="@i">
                                    <td>@(i + 1)</td>
                                    <td class="font-monospace">@r.MaSoSV</td>
                                    <td class="text-start">
                                        @r.HoTen
                                        <input type="hidden" name="Rows[@i].MaSinhVien" value="@r.MaSinhVien" />
                                        <input type="hidden" name="Rows[@i].MaSoSV" value="@r.MaSoSV" />
                                        <input type="hidden" name="Rows[@i].HoTen" value="@r.HoTen" />
                                    </td>
                                    <td>
                                        @if (editable)
                                        {
                                            <input name="Rows[@i].DiemQT"
                                                   class="form-control form-control-sm score-input mx-auto js-qt"
                                                   type="number" step="0.01" min="0" max="10"
                                                   value="@(r.DiemQT?.ToString("0.##"))" />
                                        }
                                        else
                                        {
                                            <span class="fw-bold">@(r.DiemQT?.ToString("0.##") ?? "—")</span>
                                            <input type="hidden" name="Rows[@i].DiemQT" value="@(r.DiemQT?.ToString())" />
                                        }
                                    </td>
                                    <td>
                                        @if (editable)
                                        {
                                            <input name="Rows[@i].DiemThi"
                                                   class="form-control form-control-sm score-input mx-auto js-thi"
                                                   type="number" step="0.01" min="0" max="10"
                                                   value="@(r.DiemThi?.ToString("0.##"))" />
                                        }
                                        else
                                        {
                                            <span class="fw-bold">@(r.DiemThi?.ToString("0.##") ?? "—")</span>
                                            <input type="hidden" name="Rows[@i].DiemThi" value="@(r.DiemThi?.ToString())" />
                                        }
                                    </td>
                                    <td>
                                        <span class="score-total js-tong">@((r.DiemTong)?.ToString("0.##") ?? "—")</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between mt-4 border-top pt-3">
                    <a asp-area="GiangVien" asp-controller="LopDay" asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại
                    </a>
                    
                    <div class="d-flex gap-2">
                        @if (editable)
                        {
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-save me-1"></i> Lưu bản nháp
                            </button>
                            
                            @* Nút gửi duyệt (cần action Submit trong controller) *@
                            <button type="submit" name="isSubmit" value="true" class="btn btn-success px-4" 
                                    onclick="return confirm('Sau khi gửi duyệt bạn sẽ không thể sửa điểm. Xác nhận gửi?')">
                                <i class="bi bi-send me-1"></i> Gửi duyệt điểm
                            </button>
                        }
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (function () {
            const editable = @((editable) ? "true" : "false");
            if (!editable) return;

            const clamp = v => Math.min(10, Math.max(0, v));
            const parse = s => {
                const n = parseFloat((s ?? '').toString().replace(',', '.'));
                return isNaN(n) ? null : n;
            };

            function recompute(row) {
                const $row = document.querySelector(`tr[data-row="${row}"]`);
                if (!$row) return;

                const iQt = $row.querySelector('.js-qt');
                const iThi = $row.querySelector('.js-thi');
                const oTong = $row.querySelector('.js-tong');

                const qt = parse(iQt.value);
                const thi = parse(iThi.value);

                if (qt != null) iQt.value = clamp(qt).toFixed(2).replace(/\.00$/, '');
                if (thi != null) iThi.value = clamp(thi).toFixed(2).replace(/\.00$/, '');

                if (qt == null && thi == null) {
                    oTong.textContent = '—';
                } else {
                    const val = ((qt ?? 0) + (thi ?? 0)) / 2.0;
                    oTong.textContent = val.toFixed(2).replace(/\.00$/, '');
                }
            }

            document.querySelectorAll('tbody tr').forEach(tr => {
                const row = tr.getAttribute('data-row');
                tr.querySelectorAll('.js-qt, .js-thi').forEach(inp => {
                    ['change', 'keyup', 'blur'].forEach(evt => {
                        inp.addEventListener(evt, () => {
                            tr.classList.add('row-dirty');
                            recompute(row);
                        });
                    });
                });
            });
        })();
    </script>
}