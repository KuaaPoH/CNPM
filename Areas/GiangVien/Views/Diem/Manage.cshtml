@using aznews.Areas.GiangVien.Models.Diem
@using aznews.Areas.Admin.Models   @* để dùng enum DiemStatus (nếu enum bạn đặt trong Areas.Admin.Models) *@
@model DiemManageVM
@{
    ViewData["Title"] = "Nhập / Sửa điểm";
    var editable = Model.TrangThai == DiemTrangThai.Editable;   // enum ở VM
}

@section styles {
    <style>
        .score-input {
            max-width: 110px;
            text-align: right;
        }

        .score-total {
            min-width: 90px;
            display: inline-block;
            text-align: right;
        }

        .row-dirty {
            background: #fff9e6;
        }

        .badge-legend .badge {
            margin-right: .5rem;
        }

        .table thead th {
            white-space: nowrap;
        }

        .table tbody td {
            vertical-align: middle;
        }
    </style>
}

<div class="pagetitle mb-3">
    <h4 class="fw-bold text-primary text-uppercase">NHẬP / SỬA ĐIỂM</h4>
</div>

<div class="card shadow-sm">
    <div class="card-body p-3 p-md-4">

        <div class="row g-3 align-items-center mb-3">
            <div class="col-md">
                <div class="fw-semibold fs-5">@Model.TenHP</div>
                <div class="text-muted small">Học kỳ: <strong>@Model.HocKy</strong> • Năm học: <strong>@Model.NamHoc</strong></div>
            </div>
            <div class="col-md-auto">
                @* Badge trạng thái *@
                @{
                    string stCls = "secondary";
                    string stText = "N/A";
                    switch (Model.TrangThai)
                    {
                        case DiemTrangThai.Editable: stCls = "secondary"; stText = "Có thể sửa"; break;
                        case DiemTrangThai.Submitted: stCls = "warning text-dark"; stText = "Đã gửi duyệt"; break;
                        case DiemTrangThai.Approved: stCls = "success"; stText = "Đã duyệt"; break;
                        case DiemTrangThai.Rejected: stCls = "danger"; stText = "Từ chối"; break;
                    }
                }
                <span class="badge bg-@stCls">@stText</span>
            </div>
        </div>

        <div class="badge-legend mb-3 small">
            <span class="text-muted me-2">Quy ước:</span>
            <span class="badge bg-light text-dark border">QT</span> = Điểm quá trình,
            <span class="badge bg-light text-dark border">Thi</span> = Điểm thi,
            <span class="badge bg-light text-dark border">Tổng</span> = (QT + Thi) / 2
        </div>

        <form asp-area="GiangVien" asp-controller="Diem" asp-action="Save" method="post" id="frmScores">
            @Html.AntiForgeryToken()
            <input type="hidden" name="MaLHP" value="@Model.MaLHP" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center" style="width:70px;">STT</th>
                            <th style="min-width:140px;">Mã SV</th>
                            <th>Họ tên</th>
                            <th class="text-end" style="width:140px;">Điểm QT</th>
                            <th class="text-end" style="width:140px;">Điểm thi</th>
                            <th class="text-end" style="width:140px;">Điểm tổng</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Rows.Count; i++)
                        {
                            var r = Model.Rows[i];
                            <tr data-row="@i">
                                <td class="text-center">@(i + 1)</td>

                                <td>
                                    <div class="fw-semibold">@r.MaSoSV</div>
                                    <input type="hidden" name="Rows[@i].MaSinhVien" value="@r.MaSinhVien" />
                                    <input type="hidden" name="Rows[@i].MaSoSV" value="@r.MaSoSV" />
                                    <input type="hidden" name="Rows[@i].HoTen" value="@r.HoTen" />
                                </td>

                                <td class="text-break">@r.HoTen</td>

                                <td class="text-end">
                                    @if (editable)
                                    {
                                        <input name="Rows[@i].DiemQT"
                                               class="form-control form-control-sm score-input js-qt"
                                               type="number" step="0.01" min="0" max="10"
                                               value="@(r.DiemQT?.ToString("0.##"))" />
                                    }
                                    else
                                    {
                                        <span>@(r.DiemQT?.ToString("0.##") ?? "—")</span>
                                        <input type="hidden" name="Rows[@i].DiemQT" value="@(r.DiemQT?.ToString())" />
                                    }
                                </td>

                                <td class="text-end">
                                    @if (editable)
                                    {
                                        <input name="Rows[@i].DiemThi"
                                               class="form-control form-control-sm score-input js-thi"
                                               type="number" step="0.01" min="0" max="10"
                                               value="@(r.DiemThi?.ToString("0.##"))" />
                                    }
                                    else
                                    {
                                        <span>@(r.DiemThi?.ToString("0.##") ?? "—")</span>
                                        <input type="hidden" name="Rows[@i].DiemThi" value="@(r.DiemThi?.ToString())" />
                                    }
                                </td>

                                <td class="text-end">
                                    <span class="score-total js-tong">@((r.DiemTong)?.ToString("0.##") ?? "—")</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between mt-3">
                <div>
                    <a asp-area="GiangVien" asp-controller="Diem" asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại
                    </a>
                    <a asp-area="GiangVien" asp-controller="Diem" asp-action="DownloadTemplate" asp-route-id="@Model.MaLHP"
                       class="btn btn-outline-success ms-2">
                        <i class="bi bi-filetype-csv me-1"></i> Tải template
                    </a>
                </div>

                <div>
                    @if (editable)
                    {
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save me-1"></i> Lưu điểm
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-primary" disabled title="Lớp đang khoá, không thể sửa">
                            <i class="bi bi-save me-1"></i> Lưu điểm
                        </button>
                    }
                </div>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const editable = @((editable) ? "true" : "false");

            if (!editable) return;

            const clamp = v => Math.min(10, Math.max(0, v));
            const parse = s => {
                const n = parseFloat((s ?? '').toString().replace(',', '.'));
                return isNaN(n) ? null : n;
            };

            function recompute(row) {
                const $row = document.querySelector(`tr[data-row="${row}"]`);
                if (!$row) return;

                const iQt = $row.querySelector('.js-qt');
                const iThi = $row.querySelector('.js-thi');
                const oTong = $row.querySelector('.js-tong');

                const qt = parse(iQt.value);
                const thi = parse(iThi.value);

                if (qt != null) iQt.value = clamp(qt).toFixed(2).replace(/\.00$/, '');
                if (thi != null) iThi.value = clamp(thi).toFixed(2).replace(/\.00$/, '');

                if (qt == null && thi == null) {
                    oTong.textContent = '—';
                } else {
                    const val = ((qt ?? 0) + (thi ?? 0)) / 2.0;
                    oTong.textContent = val.toFixed(2).replace(/\.00$/, '');
                }
            }

            // lắng nghe thay đổi
            document.querySelectorAll('tbody tr').forEach(tr => {
                const row = tr.getAttribute('data-row');
                tr.querySelectorAll('.js-qt, .js-thi').forEach(inp => {
                    ['change', 'keyup', 'blur'].forEach(evt => {
                        inp.addEventListener(evt, () => {
                            tr.classList.add('row-dirty');
                            recompute(row);
                        });
                    });
                });
            });
        })();
    </script>
}
