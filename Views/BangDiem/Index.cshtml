@model aznews.Models.Diem.BangDiemIndexVM
@{
    ViewData["Title"] = "Bảng điểm chi tiết";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="section">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <!-- Header -->
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="fw-bold text-primary mb-0 text-uppercase">Bảng điểm chi tiết</h4>
                    </div>

                    <!-- Filter Form -->
                    <form method="get" class="mb-4">
                        <div class="row g-3 align-items-end">
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Năm học</label>
                                <select name="namHoc" class="form-select">
                                    <option value="">— Tất cả năm học —</option>
                                    @foreach (var nh in Model.NamHocs ?? Enumerable.Empty<string>())
                                    {
                                        <option value="@nh" selected="@(Model.FilterNamHoc == nh)">
                                            @nh
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Học kỳ</label>
                                <select name="hocKy" class="form-select">
                                    <option value="">— Tất cả học kỳ —</option>
                                    @foreach (var hk in Model.HocKys ?? Enumerable.Empty<string>())
                                    {
                                        <option value="@hk" selected="@(Model.FilterHocKy == hk)">
                                            @hk
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-3">
                                <button type="submit" class="btn btn-primary me-2">
                                    <i class="bi bi-funnel me-1"></i> Lọc dữ liệu
                                </button>
                                <a class="btn btn-outline-secondary" href="@(Url.Action("Index", "BangDiem"))">
                                    <i class="bi bi-x-circle me-1"></i> Xóa lọc
                                </a>
                            </div>
                        </div>
                    </form>

                    <!-- Data Table -->
                    @if (Model.Rows == null || !Model.Rows.Any())
                    {
                        <div class="alert alert-info d-flex align-items-center" role="alert">
                            <i class="bi bi-info-circle me-2"></i>
                            <div>
                                Chưa có học phần đã được duyệt hoặc không khớp điều kiện lọc.
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover align-middle text-center">
                                <thead class="table-light text-nowrap">
                                    <tr>
                                        <th style="width: 5%">STT</th>
                                        <th style="width: 15%">Năm học</th>
                                        <th style="width: 10%">Học kỳ</th>
                                        <th style="width: 15%">Mã HP</th>
                                        <th class="text-start">Tên học phần</th>
                                        <th style="width: 10%">Số TC</th>
                                        <th style="width: 10%">Điểm QT</th>
                                        <th style="width: 10%">Điểm thi</th>
                                        <th style="width: 10%">Điểm tổng</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        var stt = 1;
                                        foreach (var r in Model.Rows)
                                        {
                                            <tr>
                                                <td>@stt</td>
                                                <td>@r.NamHoc</td>
                                                <td>@r.HocKy</td>
                                                <td>@r.MaSoHP</td>
                                                <td class="text-start fw-bold text-dark">@r.TenHP</td>
                                                <td>@r.SoTC</td>
                                                <td>
                                                    @if (r.DiemQT.HasValue)
                                                    {
                                                        <span class="badge bg-light text-dark border">@r.DiemQT.Value.ToString("0.00")</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">—</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (r.DiemThi.HasValue)
                                                    {
                                                        <span class="badge bg-light text-dark border">@r.DiemThi.Value.ToString("0.00")</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">—</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (r.DiemTong.HasValue)
                                                    {
                                                        <span class="badge bg-success">@r.DiemTong.Value.ToString("0.00")</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">—</span>
                                                    }
                                                </td>
                                            </tr>
                                            stt++;
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</section>