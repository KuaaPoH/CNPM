@model aznews.Models.SinhVienProfileVM

@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    Layout = "~/Views/Shared/_LayoutStudent.cshtml";
}

<div class="pagetitle">
    <h1>Hồ sơ cá nhân</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
            <li class="breadcrumb-item active">Profile</li>
        </ol>
    </nav>
</div>

<section class="section profile">
    <div class="row">
        
        <!-- Cột trái: Avatar Card -->
        <div class="col-xl-4">
            <div class="card">
                <div class="card-body profile-card pt-4 d-flex flex-column align-items-center">
                    <img src="~/admin/Imgs/@Model.CurrentAvatar" alt="Profile" class="rounded-circle border border-3 border-primary p-1" style="width: 120px; height: 120px; object-fit: cover;" onerror="this.src='/admin/Imgs/default-avatar.png'">
                    <h2 class="mt-3">@Model.HoTen</h2>
                    <h3 class="text-muted">@Model.MaSoSV</h3>
                    <div class="social-links mt-2">
                        <span class="badge bg-primary"><i class="bi bi-people-fill me-1"></i> @Model.LopHanhChinh</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cột phải: Form -->
        <div class="col-xl-8">
            <div class="card">
                <div class="card-body pt-3">
                    
                    <!-- Thông báo -->
                    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle me-1"></i> @Model.SuccessMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-octagon me-1"></i> @Model.ErrorMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <!-- Tabs -->
                    <ul class="nav nav-tabs nav-tabs-bordered">
                        <li class="nav-item">
                            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#profile-edit">Chỉnh sửa thông tin</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#profile-change-password">Đổi mật khẩu</button>
                        </li>
                    </ul>

                    <div class="tab-content pt-2">

                        <!-- Tab 1: Edit Profile -->
                        <div class="tab-pane fade show active profile-edit pt-3" id="profile-edit">
                            <form asp-action="UpdateInfo" method="post" enctype="multipart/form-data">
                                <input type="hidden" asp-for="MaSoSV" />
                                <input type="hidden" asp-for="CurrentAvatar" />

                                <div class="row mb-3">
                                    <label for="profileImage" class="col-md-4 col-lg-3 col-form-label">Ảnh đại diện</label>
                                    <div class="col-md-8 col-lg-9">
                                        <input class="form-control" type="file" asp-for="AvatarFile" accept="image/*">
                                        <div class="form-text small">Chọn ảnh mới để thay đổi (JPG, PNG).</div>
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <label class="col-md-4 col-lg-3 col-form-label">Họ và tên</label>
                                    <div class="col-md-8 col-lg-9">
                                        <input asp-for="HoTen" class="form-control" />
                                        <span asp-validation-for="HoTen" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <label class="col-md-4 col-lg-3 col-form-label">Ngày sinh</label>
                                    <div class="col-md-8 col-lg-9">
                                        <input asp-for="NgaySinh" class="form-control" type="date" />
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <label class="col-md-4 col-lg-3 col-form-label">Giới tính</label>
                                    <div class="col-md-8 col-lg-9">
                                        <select asp-for="GioiTinh" class="form-select">
                                            <option value="">-- Chọn --</option>
                                            <option value="Nam">Nam</option>
                                            <option value="Nữ">Nữ</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <label class="col-md-4 col-lg-3 col-form-label">Email</label>
                                    <div class="col-md-8 col-lg-9">
                                        <input asp-for="Email" class="form-control" />
                                        <span asp-validation-for="Email" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <label class="col-md-4 col-lg-3 col-form-label">Số điện thoại</label>
                                    <div class="col-md-8 col-lg-9">
                                        <input asp-for="SoDienThoai" class="form-control" />
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <label class="col-md-4 col-lg-3 col-form-label">Địa chỉ</label>
                                    <div class="col-md-8 col-lg-9">
                                        <input asp-for="DiaChi" class="form-control" />
                                    </div>
                                </div>

                                <div class="text-center">
                                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                                </div>
                            </form>
                        </div>

                        <!-- Tab 2: Change Password -->
                        <div class="tab-pane fade pt-3" id="profile-change-password">
                            <form asp-action="ChangePass" method="post">
                                <input type="hidden" asp-for="MaSoSV" />
                                <input type="hidden" asp-for="HoTen" /> 
                                <input type="hidden" asp-for="CurrentAvatar" />

                                <div class="row mb-3">
                                    <label class="col-md-4 col-lg-3 col-form-label">Mật khẩu hiện tại</label>
                                    <div class="col-md-8 col-lg-9">
                                        <input asp-for="CurrentPass" type="password" class="form-control" />
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <label class="col-md-4 col-lg-3 col-form-label">Mật khẩu mới</label>
                                    <div class="col-md-8 col-lg-9">
                                        <input asp-for="NewPass" type="password" class="form-control" />
                                        <span asp-validation-for="NewPass" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <label class="col-md-4 col-lg-3 col-form-label">Nhập lại mật khẩu mới</label>
                                    <div class="col-md-8 col-lg-9">
                                        <input asp-for="ConfirmPass" type="password" class="form-control" />
                                        <span asp-validation-for="ConfirmPass" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="text-center">
                                    <button type="submit" class="btn btn-danger">Đổi mật khẩu</button>
                                </div>
                            </form>
                        </div>

                    </div><!-- End Bordered Tabs -->

                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
