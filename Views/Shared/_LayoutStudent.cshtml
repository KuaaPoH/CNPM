@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>Cổng thông tin Sinh viên</title>
    
    <link href="~/admin/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/admin/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    <link href="~/admin/css/style.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <style>
        /* Tùy biến riêng cho Student Portal */
        .sidebar { width: 260px; }
        #main, #footer { margin-left: 260px; }
        @@media (max-width: 1199px) {
            #main, #footer { margin-left: 0; }
        }
        
        .card-icon { color: #fff; }
        .sales-card .card-icon { background: #4154f1; }
    </style>
</head>

<body>

    <!-- ======= Header ======= -->
    <header id="header" class="header fixed-top d-flex align-items-center">

        <div class="d-flex align-items-center justify-content-between">
            <a href="/" class="logo d-flex align-items-center">
                <img src="~/Imgs/Logodhv.webp" alt="">
                <span class="d-none d-lg-block">Student Portal</span>
            </a>
            <i class="bi bi-list toggle-sidebar-btn"></i>
        </div>

        <nav class="header-nav ms-auto">
            <ul class="d-flex align-items-center">
                <li class="nav-item dropdown pe-3">
                    <a class="nav-link nav-profile d-flex align-items-center pe-0" href="#" data-bs-toggle="dropdown">
                        <img src="~/admin/Imgs/@(Context.Session.GetString("Avatar") ?? "default-user.png")" alt="Profile" class="rounded-circle" onerror="this.src='/admin/Imgs/default-avatar.png'">
                        <span class="d-none d-md-block dropdown-toggle ps-2">@(Context.Session.GetString("FullName") ?? "Sinh viên")</span>
                    </a>

                    <ul class="dropdown-menu dropdown-menu-end dropdown-menu-arrow profile">
                        <li class="dropdown-header">
                            <h6>@(Context.Session.GetString("FullName") ?? "Sinh viên")</h6>
                            <span>@(Context.Session.GetString("UserName"))</span>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item d-flex align-items-center" href="/Profile">
                                <i class="bi bi-person"></i>
                                <span>Hồ sơ cá nhân</span>
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item d-flex align-items-center" href="/Account/Logout">
                                <i class="bi bi-box-arrow-right"></i>
                                <span>Đăng xuất</span>
                            </a>
                        </li>
                    </ul>
                </li>
            </ul>
        </nav>
    </header>

    <!-- ======= Sidebar ======= -->
    <aside id="sidebar" class="sidebar">
        <ul class="sidebar-nav" id="sidebar-nav">

            <li class="nav-heading">Học tập</li>

            <li class="nav-item">
                <a class="nav-link " href="/">
                    <i class="bi bi-grid"></i>
                    <span>Tổng quan (Dashboard)</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link collapsed" href="#">
                    <i class="bi bi-calendar-check"></i>
                    <span>Thời khóa biểu</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link collapsed" href="/BangDiem">
                    <i class="bi bi-bar-chart"></i>
                    <span>Kết quả học tập</span>
                </a>
            </li>
            
             <li class="nav-item">
                <a class="nav-link collapsed" href="#">
                    <i class="bi bi-pencil-square"></i>
                    <span>Đăng ký tín chỉ</span>
                </a>
            </li>

            <li class="nav-heading">Cá nhân</li>

            <li class="nav-item">
                <a class="nav-link collapsed" href="/Profile">
                    <i class="bi bi-person"></i>
                    <span>Hồ sơ sinh viên</span>
                </a>
            </li>

             <li class="nav-item">
                <a class="nav-link collapsed" href="#">
                    <i class="bi bi-cash-coin"></i>
                    <span>Học phí</span>
                </a>
            </li>
        </ul>
    </aside>

    <main id="main" class="main">
        @RenderBody()
    </main>

    <a href="#" class="back-to-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

    <!-- Vendor JS Files -->
    <script src="~/admin/vendor/apexcharts/apexcharts.min.js"></script>
    <script src="~/admin/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/admin/vendor/chart.js/chart.min.js"></script>
    <script src="~/admin/vendor/echarts/echarts.min.js"></script>
    <script src="~/admin/vendor/simple-datatables/simple-datatables.js"></script>
    <script src="~/admin/vendor/tinymce/tinymce.min.js"></script>

    <!-- Template Main JS File -->
    <script src="~/admin/js/main.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
